rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidLeaderboardEntry() {
      return hasRequiredFields(['userId', 'displayName', 'score', 'timestamp']) &&
             request.resource.data.userId is string &&
             request.resource.data.displayName is string &&
             request.resource.data.displayName.size() <= 50 &&
             request.resource.data.score is number &&
             request.resource.data.score >= 0 &&
             (request.resource.data.timestamp is timestamp || request.resource.data.timestamp == request.time);
    }

    match /{collection}/{userId} {
      // Identity check for leaderboard read operations
      allow list: if collection in ['leaderboard', 'leaderboard_google', 'leaderboard_facebook', 'leaderboard_playgames', 'leaderboard_guest'];
      
      allow get: if collection in ['leaderboard', 'leaderboard_google', 'leaderboard_facebook', 'leaderboard_playgames', 'leaderboard_guest'];
      
      // Users can only create their own scores
      allow create: if collection in ['leaderboard_google', 'leaderboard_facebook', 'leaderboard_playgames', 'leaderboard_guest'] &&
                    isAuthenticated() && 
                    userId == request.auth.uid &&
                    request.resource.data.userId == request.auth.uid &&
                    isValidLeaderboardEntry();
                    
      // Users can update their own score if it's higher, or just update their profile
      allow update: if collection in ['leaderboard_google', 'leaderboard_facebook', 'leaderboard_playgames', 'leaderboard_guest'] &&
                    isAuthenticated() && 
                    userId == request.auth.uid &&
                    request.resource.data.userId == request.auth.uid &&
                    (
                      // Only modifying score, timestamp, photoURL, displayName, userId
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'timestamp', 'displayName', 'photoURL', 'userId'])
                    );
      
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    hasRequiredFields(['userId', 'displayName', 'text', 'timestamp']) &&
                    request.resource.data.userId is string &&
                    request.resource.data.displayName is string &&
                    request.resource.data.text is string &&
                    request.resource.data.text.size() > 0 &&
                    request.resource.data.text.size() <= 2000 &&
                    request.resource.data.timestamp is timestamp;
      allow read, update, delete: if false;
    }

    // Publicly readable path for connectivity heartbeats
    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
